# DocLens 环境变量模板 —— 复制为 .env 并填真实值（.env 已被 .gitignore 排除，不入库）

# 火山方舟（嵌入 + 生成）：https://console.volcengine.com 火山方舟 → API Key 管理
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# 嵌入端点：M0 §0.4 冒烟探测后回填（coding/v3 或 api/v3）
ARK_EMBED_BASE_URL=

# 模型名集中管理（改名只动这里；以方舟模型列表页 Model ID 为准）
EMBED_MODEL=doubao-embedding-vision-251215
EMBED_DIMENSIONS=2048
# 主力 VLM（火山 Coding Plan 支持第三方模型，含 glm-5.3-flash / kimi-k3 / deepseek-v4.1-flash 等）
GEN_MODEL=glm-5.3-flash
CTX_MODEL=deepseek-v4-flash
RERANK_MODEL_FLASH=deepseek-v4-flash     # D 档重排器对比位之一
RERANK_MODEL_PRO=doubao-seed-2-1-pro-260915

# 服务器存储（走 SSH 隧道则一律 127.0.0.1）
MYSQL_URL=mysql+pymysql://<用户>:<密码>@127.0.0.1:3306/doclens
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# MinerU 桥接（m1-runbook 1.3）：doclens-mineru 环境的 mineru-kit 绝对路径，两端各自配置
# 容器示例：MINERU_BIN=/opt/conda/envs/doclens-mineru/bin/mineru-kit
# Windows 示例：MINERU_BIN=D:\soft\anaconda\envs\doclens-mineru\Scripts\mineru-kit.exe
MINERU_BIN=
MINERU_TIMEOUT=1800
